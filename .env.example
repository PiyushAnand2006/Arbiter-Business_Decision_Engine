# Copy to .env and adjust. Everything has a sensible default; the demo runs
# fully offline with the mock provider.

# LLM provider for the debate agents: mock | claude | gemini
LLM_PROVIDER=mock
# Leave empty for the provider default (claude -> claude-opus-5-5, gemini -> gemini-2.5-flash)
LLM_MODEL=
# Claude: thinking depth per call (low | medium | high). Sampling params are not used on current Claude models.
LLM_EFFORT=low
# Gemini only: judge temperature
LLM_TEMPERATURE_JUDGE=0.2

# Credentials (never commit real keys)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Cost controls
MAX_DEBATES_PER_SESSION=25
MAX_CALLS_PER_CONFLICT=4
# Re-judge with sides swapped (position-bias check) above this expected revenue
CONSISTENCY_CHECK_MIN_STAKE=100000

# Confidence engine
THRESH_LOW=0.60
NUMERIC_TOLERANCE=0.005
# WEIGHTS={"F": 0.5, "R": 0.15, "A": 0.35}

# Data
SEED=42
N_DEALS=50

# Optional Slack-compatible webhook for high-severity verdicts (off when empty)
ALERT_WEBHOOK_URL=
ALERT_MIN_SEVERITY=high

# Background monitor
MONITOR_ENABLED=true
MONITOR_INTERVAL_S=4
# Artificial latency for the mock provider so the debate is visible in the UI
MOCK_LATENCY_MS=350
